def host_probe_targets():
    targets = []
    ts = run(["tailscale", "ip", "-4"], check=False).stdout.split()
    if ts:
        targets.append(f"{ts[0]}:22")
    route = run(["ip", "-4", "route", "get", "1.1.1.1"], check=False).stdout
    m = re.search(r"src (\S+)", route)
    if m:
        targets.append(f"{m.group(1)}:22")
    m = re.search(r"via (\S+)", route)
    if m:
        targets.append(f"{m.group(1)}:80")
    return targets


def cmd_selftest(a):
    cfg = load_config()
    blocked = host_probe_targets() if cfg["block_private_network"] else []
    print(f"probing from a sandbox; must be blocked: {' '.join(blocked) or '(firewall disabled)'}", flush=True)
    rc = interactive_sandbox(cfg, "selftest", env=[f"RSA_PROBE_BLOCKED={' '.join(blocked)}",
                                                    "RSA_PROBE_OPEN=1.1.1.1:443"])
    sys.exit(rc)


def cmd_doctor(a):
    cfg = load_config()
    checks = []

    def check(name, ok, detail=""):
        checks.append({"name": name, "ok": bool(ok), "detail": detail})

    check("python", sys.version_info >= (3, 9), sys.version.split()[0])
    check("git", shutil.which("git"), run(["git", "--version"], check=False).stdout.strip())
    docker_ok = False
    try:
        rootless = docker_is_rootless(cfg)
        docker_ok = True
        check("docker daemon", True, cfg["docker_host"])
        check("docker is rootless", rootless or not cfg["require_rootless"],
              "rootless" if rootless else "ROOTFUL: containers would run as real root")
    except (RsaError, subprocess.TimeoutExpired) as e:
        check("docker daemon", False, str(e))
    if docker_ok:
        have, want = image_hash(cfg), sandbox_hash(cfg)
        check("sandbox image", have == want,
              "up to date" if have == want else ("missing" if have is None else "stale: run `rsa server build`"))
        vol = docker("volume", "inspect", cfg["data_volume"], check=False, cfg=cfg).returncode == 0
        check("opencode data volume", vol, cfg["data_volume"])
        stray = docker("ps", "-a", "--filter", "label=rsa.task", "--format", "{{.Names}} {{.Status}}",
                       check=False, cfg=cfg).stdout.strip()
        check("sandbox containers", True, stray.replace("\n", "; ") or "none")
    ws = worker_state()
    check("worker service", ws == "active", f"{UNIT_NAME}: {ws}")
    linger = run(["loginctl", "show-user", os.environ.get("USER", ""), "-p", "Linger"], check=False).stdout
    check("user lingering (worker survives logout/reboot)", "Linger=yes" in linger, linger.strip())
    ctrl = Path(f"/sys/fs/cgroup/user.slice/user-{os.getuid()}.slice/user@{os.getuid()}.service/cgroup.controllers")
    have_ctrl = set(ctrl.read_text().split()) if ctrl.exists() else set()
    check("cgroup limits (cpu, memory, pids)", {"cpu", "memory", "pids"} <= have_ctrl,
          " ".join(sorted(have_ctrl)) or "unknown")
    du = shutil.disk_usage(RSA_HOME if RSA_HOME.exists() else Path.home())
    check("disk space", du.free > 5e9, f"{du.free / 1e9:.0f} GB free")
    if ENV_FILE.exists():
        mode = ENV_FILE.stat().st_mode & 0o777
        check("secrets file permissions", mode == 0o600, f"{ENV_FILE} mode {oct(mode)}")
    states = {}
    for t in os.listdir(TASKS) if TASKS.exists() else []:
        if ID_RE.match(t):
            s = read_json(TASKS / t / "status.json", {}).get("state", "?")
            states[s] = states.get(s, 0) + 1
    check("tasks", True, ", ".join(f"{k}: {v}" for k, v in sorted(states.items())) or "none")
    check("default model", True, cfg["default_model"])
    emit({"ok": all(c["ok"] for c in checks), "version": VERSION, "home": str(RSA_HOME), "checks": checks})


