# ------------------------------------------------------------------ main

def main():
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    p = argparse.ArgumentParser(prog="rsa-server", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("ensure-repo"); s.add_argument("repo"); s.set_defaults(fn=cmd_ensure_repo)
    s = sub.add_parser("submit", help="queue a task (JSON request on stdin)"); s.set_defaults(fn=cmd_submit)
    s = sub.add_parser("status"); s.add_argument("id"); s.add_argument("--prompt", action="store_true")
    s.set_defaults(fn=cmd_status)
    s = sub.add_parser("list"); s.add_argument("--repo"); s.add_argument("--limit", type=int, default=20)
    s.add_argument("--active", action="store_true"); s.set_defaults(fn=cmd_list)
    s = sub.add_parser("wait"); s.add_argument("id"); s.add_argument("--timeout", type=int, default=300)
    s.set_defaults(fn=cmd_wait)
    s = sub.add_parser("logs"); s.add_argument("id"); s.add_argument("-f", "--follow", action="store_true")
    s.add_argument("--raw", action="store_true"); s.add_argument("--sandbox", action="store_true")
    s.add_argument("-n", "--tail", type=int, default=0); s.set_defaults(fn=cmd_logs)
    s = sub.add_parser("cancel"); s.add_argument("id"); s.set_defaults(fn=cmd_cancel)
    s = sub.add_parser("retry"); s.add_argument("id"); s.add_argument("--model"); s.set_defaults(fn=cmd_retry)

    s = sub.add_parser("worker", help="run the worker loop (systemd)"); s.set_defaults(fn=cmd_worker)
    s = sub.add_parser("setup", help="create state dirs, build image, install + start the worker")
    s.set_defaults(fn=cmd_setup)
    s = sub.add_parser("build"); s.add_argument("--pull", action="store_true"); s.set_defaults(fn=cmd_build)
